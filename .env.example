# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Port serveur (3000 par défaut)
PORT=3000

# BASE DE DONNÉES MYSQL
DATABASE_URL="mysql://ced_user:secure_password@localhost:3306/doctorat_db"

# AUTHENTIFICATION & SÉCURITÉ
JWT_SECRET="super_secret_jwt_key_doctorat_maroc_2026_min_32_chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="super_secure_cookie_secret_doctorat_maroc"

# CONFIGURATION SMTP EMAIL (Nodemailer)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="votre_utilisateur_smtp"
SMTP_PASS="votre_mot_de_passe_smtp"
SMTP_FROM="CED Doctorat <ne-pas-repondre@universite.ac.ma>"
EMAIL_SIMULATION_MODE="true" # Si "true", consigne les emails en base et console sans bloquer

# STOCKAGE DES FICHIERS JUSTIFICATIFS (Multer)
UPLOAD_DIR="./uploads/documents"
MAX_FILE_SIZE_BYTES=5242880 # 5 Mo

